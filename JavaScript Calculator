<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Red & Black Calculator</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        body{
            background: linear-gradient(135deg,#000000,#1a1a1a,#4d0000,#000000);
            background-size:400% 400%;
            animation:bgAnimation 10s ease infinite;
        }

        @keyframes bgAnimation{
            0%{background-position:0% 50%;}
            50%{background-position:100% 50%;}
            100%{background-position:0% 50%;}
        }

        .card{
            background:rgba(20,20,20,0.85);
            backdrop-filter:blur(12px);
            border:2px solid #ff1a1a;
            box-shadow:
                0 0 25px rgba(255,0,0,.5),
                0 0 60px rgba(255,0,0,.2);
        }

        .input3d{
            background:#111;
            color:white;
            border:1px solid #ff3333;
            box-shadow:
                inset 3px 3px 6px rgba(0,0,0,.8),
                inset -2px -2px 6px rgba(255,255,255,.05);
            transition:.3s;
        }

        .input3d:focus{
            outline:none;
            box-shadow:
                0 0 12px red,
                inset 3px 3px 6px rgba(0,0,0,.8);
        }

        .btn3d{
            background:linear-gradient(145deg,#ff0000,#990000);
            box-shadow:
                0 8px 15px rgba(255,0,0,.6),
                inset 0 2px 2px rgba(255,255,255,.2);
            transition:.3s;
        }

        .btn3d:hover{
            transform:translateY(-3px);
            box-shadow:
                0 0 30px red,
                0 12px 20px rgba(255,0,0,.7);
        }

        .btn3d:active{
            transform:translateY(2px);
        }

        #result{
            background:#111;
            border:1px solid red;
            box-shadow:0 0 15px rgba(255,0,0,.4);
        }
    </style>
</head>

<body class="flex justify-center items-center min-h-screen">

<div class="card w-96 rounded-3xl p-8">

    <h1 class="text-4xl font-extrabold text-center text-red-500 mb-6 drop-shadow-lg">
        🧮 Calculator
    </h1>

    <input
        type="number"
        id="num1"
        placeholder="Enter First Number"
        class="input3d w-full p-3 rounded-xl mb-4"
    >

    <select
        id="operation"
        class="input3d w-full p-3 rounded-xl mb-4"
    >
        <option value="add">➕ Addition</option>
        <option value="subtract">➖ Subtraction</option>
        <option value="multiply">✖ Multiplication</option>
        <option value="divide">➗ Division</option>
    </select>

    <input
        type="number"
        id="num2"
        placeholder="Enter Second Number"
        class="input3d w-full p-3 rounded-xl mb-5"
    >

    <button
        onclick="calculate()"
        class="btn3d w-full py-3 rounded-xl text-xl font-bold text-white"
    >
        Calculate
    </button>

    <div
        id="result"
        class="mt-6 py-3 rounded-xl text-center text-2xl font-bold text-green-400"
    >
        Result:
    </div>

    <!-- Watermark -->
    <div class="mt-8 border-t border-red-700 pt-4 text-center text-sm text-gray-400">
        <p>
            Submitted by
            <span class="font-bold text-red-500">Kishan Jangid</span>
        </p>
        <p class="text-red-400">PRN: 1272251069</p>
    </div>

</div>

<script>
function calculate() {

    const num1 = parseFloat(document.getElementById("num1").value);
    const num2 = parseFloat(document.getElementById("num2").value);
    const operation = document.getElementById("operation").value;

    let result;

    if (isNaN(num1) || isNaN(num2)) {
        document.getElementById("result").innerHTML =
            "<span style='color:#ff4d4d'>Please enter both numbers.</span>";
        return;
    }

    switch(operation){

        case "add":
            result = num1 + num2;
            break;

        case "subtract":
            result = num1 - num2;
            break;

        case "multiply":
            result = num1 * num2;
            break;

        case "divide":
            if(num2 === 0){
                result = "Cannot divide by zero";
            }else{
                result = num1 / num2;
            }
            break;

        default:
            result = "Invalid Operation";
    }

    document.getElementById("result").innerHTML =
        `<span style="color:#00ff66;">Result: ${result}</span>`;
}
</script>

</body>
</html>
